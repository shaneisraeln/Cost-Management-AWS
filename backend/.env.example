# Backend configuration. Copy to backend/.env and fill in real values.

# App
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated browser origins allowed by CORS. In production set this to
# your deployed frontend, e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (async driver)
DATABASE_URL=postgresql+asyncpg://ccc:ccc_password@localhost:55432/ccc

# Redis (Celery broker/result backend + cache)
REDIS_URL=redis://localhost:63790/0

# Clerk (application auth). Get these from the Clerk dashboard.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>
CLERK_WEBHOOK_SECRET=whsec_xxx

# Groq (AI explanations only, never financial truth)
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

# AWS (local development uses the default credential chain / named profile)
AWS_REGION=us-east-1
AWS_PROFILE=cost-management-dev
# Set to true only to allow tests/dev to make real AWS API calls.
AWS_ALLOW_REAL_CALLS=false

# --- Cross-account AssumeRole (production) ---
# The IAM principal the deployed app runs as; customer roles must trust this.
# Leave empty in local dev. REQUIRED before customers can connect via AssumeRole.
APP_AWS_PRINCIPAL_ARN=
# Optional named profile for the app's base credentials in local dev when
# exercising the AssumeRole path. In production, leave empty (instance/task role).
APP_AWS_PROFILE=
# Server-side secret used to derive per-connection External IDs (HMAC).
# Set a strong random value in production. NOT an AWS credential.
EXTERNAL_ID_SECRET=dev-external-id-secret-change-me
